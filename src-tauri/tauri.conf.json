{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "StudyFrame",
  "version": "1.0.1",
  "identifier": "com.studyframe.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "StudyFrame",
        "width": 1440,
        "height": 900,
        "minWidth": 1180,
        "minHeight": 720,
        "decorations": false,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "publisher": "CollinP",
    "targets": ["nsis", "msi"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "shortDescription": "Study planner for online courses",
    "longDescription": "A local-first study planner for online courses. Import a course, set a target date and your weekly hours, and StudyFrame paces the sections across weeks and days.",
    "windows": {
      "webviewInstallMode": { "type": "embedBootstrapper" },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico"
      }
    },
    "fileAssociations": [
      {
        "ext": ["studyframe.json"],
        "name": "StudyFrame workspace",
        "description": "StudyFrame workspace export",
        "role": "Editor"
      }
    ]
  }
}
